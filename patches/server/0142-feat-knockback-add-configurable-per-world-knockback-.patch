+package dev.zaryxstudios.escanergang.omegaspigot.knockback;
+
+import dev.zaryxstudios.escanergang.omegaspigot.config.OmegaSpigotConfig;
+import dev.zaryxstudios.escanergang.omegaspigot.config.OmegaSpigotWorldConfig;
+import org.bukkit.World;
+import org.bukkit.craftbukkit.CraftWorld;
+
+public final class OmegaKnockbackController implements KnockbackController {
+
+    public static final OmegaKnockbackController INSTANCE = new OmegaKnockbackController();
+
+    private OmegaKnockbackController() {
+    }
+
+    @Override
+    public boolean isEnabled(World world) {
+        return OmegaSpigotConfig.getWorldConfig(world.getName()).knockback.enabled;
+    }
+
+    @Override
+    public void setEnabled(World world, boolean enabled) {
+        writableConfig(world).knockback.enabled = enabled;
+    }
+
+    @Override
+    public KnockbackProfile getProfile(World world) {
+        OmegaSpigotWorldConfig.KnockbackConfig knockback = OmegaSpigotConfig.getWorldConfig(world.getName()).knockback;
+        KnockbackProfile profile = new KnockbackProfile();
+        profile.setFriction(knockback.friction);
+        profile.setHorizontal(knockback.horizontal);
+        profile.setVertical(knockback.vertical);
+        profile.setVerticalLimit(knockback.verticalLimit);
+        profile.setExtraHorizontal(knockback.extraHorizontal);
+        profile.setExtraVertical(knockback.extraVertical);
+        return profile;
+    }
+
+    @Override
+    public void setProfile(World world, KnockbackProfile profile) {
+        KnockbackProfile values = profile.copy();
+        OmegaSpigotWorldConfig.KnockbackConfig knockback = writableConfig(world).knockback;
+        knockback.friction = values.getFriction();
+        knockback.horizontal = values.getHorizontal();
+        knockback.vertical = values.getVertical();
+        knockback.verticalLimit = values.getVerticalLimit();
+        knockback.extraHorizontal = values.getExtraHorizontal();
+        knockback.extraVertical = values.getExtraVertical();
+    }
+
+    @Override
+    public void resetProfile(World world) {
+        setProfile(world, new KnockbackProfile());
+    }
+
+    @Override
+    public void save() {
+        OmegaSpigotConfig.saveWorldConfigs();
+    }
+    
+    private static OmegaSpigotWorldConfig writableConfig(World world) {
+        OmegaSpigotWorldConfig config = OmegaSpigotConfig.getOrCreateWorldConfig(world.getName());
+        ((CraftWorld) world).getHandle().omegaSpigotConfig = config;
+        return config;
+    }
+}
