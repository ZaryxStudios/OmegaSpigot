+++ b/src/main/java/dev/zaryxstudios/escanergang/omegaspigot/config/OmegaSpigotWorldConfig.java
@@ -14,12 +14,55 @@ public class OmegaSpigotWorldConfig {
 
     @ConfigSerializable
     public static class KnockbackConfig {
+        // OmegaSpigot start - Toggle custom knockback per world
+        @Comment("When false, vanilla knockback is used in this world.")
+        public boolean enabled = true;
+        // OmegaSpigot end
+
         public double friction = 2.0;
         public double horizontal = 0.4;
         public double vertical = 0.4;
         public double verticalLimit = 0.4000000059604645;
         public double extraHorizontal = 0.5;
         public double extraVertical = 0.1;
+
+        // OmegaSpigot start - Replace invalid knockback values with defaults on load
+        public void sanitize(String worldName) {
+            if (!(friction > 0.0) || Double.isInfinite(friction)) {
+                warn(worldName, "friction", friction, 2.0);
+                friction = 2.0;
+            }
+            if (!isFiniteNonNegative(horizontal)) {
+                warn(worldName, "horizontal", horizontal, 0.4);
+                horizontal = 0.4;
+            }
+            if (!Double.isFinite(vertical)) {
+                warn(worldName, "vertical", vertical, 0.4);
+                vertical = 0.4;
+            }
+            if (!isFiniteNonNegative(verticalLimit)) {
+                warn(worldName, "verticalLimit", verticalLimit, 0.4000000059604645);
+                verticalLimit = 0.4000000059604645;
+            }
+            if (!isFiniteNonNegative(extraHorizontal)) {
+                warn(worldName, "extraHorizontal", extraHorizontal, 0.5);
+                extraHorizontal = 0.5;
+            }
+            if (!Double.isFinite(extraVertical)) {
+                warn(worldName, "extraVertical", extraVertical, 0.1);
+                extraVertical = 0.1;
+            }
+        }
+
+        private static boolean isFiniteNonNegative(double value) {
+            return Double.isFinite(value) && value >= 0.0;
+        }
+
+        private static void warn(String worldName, String field, double value, double fallback) {
+            java.util.logging.Logger.getLogger("OmegaSpigot").warning("Invalid knockback." + field + " (" + value
+                    + ") for world '" + worldName + "' in omegaspigot.yml, using " + fallback);
+        }
+        // OmegaSpigot end
     }
 
