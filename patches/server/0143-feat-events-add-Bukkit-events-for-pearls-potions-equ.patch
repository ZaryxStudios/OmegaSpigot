@@ -583,6 +586,12 @@ public abstract class EntityLiving extends Entity {
         return (MobEffect) this.effects.get(Integer.valueOf(mobeffectlist.id));
     }
 
+    // OmegaSpigot start - potion effect helper
+    private org.bukkit.potion.PotionEffect toBukkitEffect(MobEffect mobeffect) {
+        return new org.bukkit.potion.PotionEffect(org.bukkit.potion.PotionEffectType.getById(mobeffect.getEffectId()), mobeffect.getDuration(), mobeffect.getAmplifier(), mobeffect.isAmbient(), mobeffect.isShowParticles());
+    }
+    // OmegaSpigot end
+
     public void addEffect(MobEffect mobeffect) {
         org.spigotmc.AsyncCatcher.catchOp( "effect add"); // Spigot
         // CraftBukkit start
@@ -592,6 +601,13 @@ public abstract class EntityLiving extends Entity {
         }
         // CraftBukkit end
         if (this.d(mobeffect)) {
+            // OmegaSpigot start - potion effect add event
+            if (!this.world.isClientSide) {
+                org.bukkit.event.entity.PotionEffectAddEvent addEvent = new org.bukkit.event.entity.PotionEffectAddEvent((org.bukkit.entity.LivingEntity) this.getBukkitEntity(), toBukkitEffect(mobeffect));
+                org.bukkit.Bukkit.getPluginManager().callEvent(addEvent);
+                if (addEvent.isCancelled()) return;
+            }
+            // OmegaSpigot end
             if (this.effects.containsKey(Integer.valueOf(mobeffect.getEffectId()))) {
                 ((MobEffect) this.effects.get(Integer.valueOf(mobeffect.getEffectId()))).a(mobeffect);
                 this.a((MobEffect) this.effects.get(Integer.valueOf(mobeffect.getEffectId())), true);
@@ -629,6 +645,16 @@ public abstract class EntityLiving extends Entity {
         MobEffect mobeffect = (MobEffect) this.effects.remove(Integer.valueOf(i));
 
         if (mobeffect != null) {
+            // OmegaSpigot start - potion effect remove event
+            if (!this.world.isClientSide) {
+                org.bukkit.event.entity.PotionEffectRemoveEvent removeEvent = new org.bukkit.event.entity.PotionEffectRemoveEvent((org.bukkit.entity.LivingEntity) this.getBukkitEntity(), toBukkitEffect(mobeffect));
+                org.bukkit.Bukkit.getPluginManager().callEvent(removeEvent);
+                if (removeEvent.isCancelled()) {
+                    this.effects.put(Integer.valueOf(i), mobeffect);
+                    return;
+                }
+            }
+            // OmegaSpigot end
             this.b(mobeffect);
         }
 
