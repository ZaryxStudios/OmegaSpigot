From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: EscanerGang <escaner@zaryxstudios.dev>
Date: Sat, 21 Nov 2026 15:10:36 +0100
Subject: [PATCH] feat(events): add Bukkit events for pearls, potions,
 equipment

- Added EnderpearlLandEvent that fires when ender pearls land on blocks or entities and supports cancellation
- Added PotionEffectAddEvent, PotionEffectExpireEvent, and PotionEffectRemoveEvent for living entity potion changes
- Added EquipmentSetEvent when player armor or equipment slots are modified by server logic
- Introduced toBukkitEffect helper to convert NMS MobEffect instances to Bukkit PotionEffect objects
- All events fire only on the server side to avoid client-side desynchronization

diff --git a/src/main/java/net/minecraft/server/EntityEnderPearl.java b/src/main/java/net/minecraft/server/EntityEnderPearl.java
index 5461e177a4a59f27b3b818ecc6fa1fd44d2f8bf9..6b5d8edc2cc6e5ee0352aae73b8524475fdee31e 100644
--- a/src/main/java/net/minecraft/server/EntityEnderPearl.java
+++ b/src/main/java/net/minecraft/server/EntityEnderPearl.java
@@ -26,6 +26,17 @@ public class EntityEnderPearl extends EntityProjectile {
     }
 
     protected void a(MovingObjectPosition movingobjectposition) {
+        // OmegaSpigot start - enderpearl land event
+        if (!this.world.isClientSide) {
+            org.bukkit.event.entity.EnderpearlLandEvent landEvent = new org.bukkit.event.entity.EnderpearlLandEvent((org.bukkit.entity.EnderPearl) this.getBukkitEntity(), movingobjectposition.entity == null ? org.bukkit.event.entity.EnderpearlLandEvent.Reason.BLOCK : org.bukkit.event.entity.EnderpearlLandEvent.Reason.ENTITY);
+            org.bukkit.Bukkit.getPluginManager().callEvent(landEvent);
+            if (landEvent.isCancelled()) {
+                this.die();
+                return;
+            }
+        }
+        // OmegaSpigot end
+
         EntityLiving entityliving = this.getShooter();
 
         if (movingobjectposition.entity != null) {
