+package dev.zaryxstudios.escanergang.omegaspigot.worldgen;
+
+import dev.zaryxstudios.escanergang.omegaspigot.config.OmegaSpigotConfig;
+import dev.zaryxstudios.escanergang.omegaspigot.config.OmegaSpigotWorldConfig;
+import net.minecraft.server.BiomeBase;
+import net.minecraft.server.Block;
+import net.minecraft.server.Blocks;
+import org.bukkit.Material;
+import org.bukkit.World;
+import org.bukkit.block.Biome;
+import org.bukkit.craftbukkit.block.CraftBlock;
+import org.bukkit.craftbukkit.util.CraftMagicNumbers;
+
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.logging.Level;
+import java.util.logging.Logger;
+
+public final class OmegaWorldGenController implements WorldGenController {
+
+    public static final OmegaWorldGenController INSTANCE = new OmegaWorldGenController();
+
+    private static final Logger LOGGER = Logger.getLogger("OmegaSpigot");
+    private static final int MAX_BLOCK_IDS = 4096;
+    private static final Map<String, Compiled> CACHE = new ConcurrentHashMap<>();
+
+    private static final class Compiled {
+        final OmegaSpigotWorldConfig source;
+        final boolean[] disabledBiomeIds = new boolean[256];
+        final boolean[] disabledBlockIds = new boolean[MAX_BLOCK_IDS];
+        final boolean[] disabledStructures = new boolean[WorldGenStructure.values().length];
+        boolean anyBiomeDisabled;
+        boolean anyBlockDisabled;
+        final Biome fallbackBiome;
+        final BiomeBase fallbackBase;
+
+        Compiled(OmegaSpigotWorldConfig source) {
+            this.source = source;
+            OmegaSpigotWorldConfig.WorldGenerationConfig gen = source.worldGeneration;
+
+            for (String name : gen.disabledBiomes) {
+                Biome biome = parse(Biome.class, name);
+                if (biome != null) {
+                    BiomeBase base = CraftBlock.biomeToBiomeBase(biome);
+                    if (base != null) {
+                        disabledBiomeIds[base.id] = true;
+                        anyBiomeDisabled = true;
+                    }
+                }
+            }
+            for (String name : gen.disabledBlocks) {
+                Material material = Material.getMaterial(name.trim().toUpperCase());
+                if (material != null) {
+                    int id = Block.getId(CraftMagicNumbers.getBlock(material));
+                    if (id >= 0 && id < MAX_BLOCK_IDS) {
+                        disabledBlockIds[id] = true;
+                        anyBlockDisabled = true;
+                    }
+                }
+            }
+            for (String name : gen.disabledStructures) {
+                WorldGenStructure structure = parse(WorldGenStructure.class, name);
+                if (structure != null) {
+                    disabledStructures[structure.ordinal()] = true;
+                }
+            }
+
+            Biome fallback = parse(Biome.class, gen.fallbackBiome);
+            this.fallbackBiome = fallback != null ? fallback : Biome.PLAINS;
+            this.fallbackBase = CraftBlock.biomeToBiomeBase(this.fallbackBiome);
+        }
+    }
+
+    private static <T extends Enum<T>> T parse(Class<T> type, String name) {
+        if (name == null) {
+            return null;
+        }
+        try {
+            return Enum.valueOf(type, name.trim().toUpperCase());
+        } catch (IllegalArgumentException e) {
+            LOGGER.log(Level.WARNING, "Unknown " + type.getSimpleName() + " in omegaspigot.yml: " + name);
+            return null;
+        }
+    }
+
+    private static Compiled compiled(String worldName) {
+        OmegaSpigotWorldConfig config = OmegaSpigotConfig.getWorldConfig(worldName);
+        Compiled compiled = CACHE.get(worldName);
+        if (compiled == null || compiled.source != config) {
+            compiled = new Compiled(config);
+            CACHE.put(worldName, compiled);
+        }
+        return compiled;
+    }
+
+    public static void filterBiomes(net.minecraft.server.World world, BiomeBase[] biomes, int length) {
+        Compiled compiled = compiled(world.worldData.getName());
+        if (!compiled.anyBiomeDisabled) {
+            return;
+        }
+        for (int i = 0; i < length && i < biomes.length; i++) {
+            BiomeBase biome = biomes[i];
+            if (biome != null && compiled.disabledBiomeIds[biome.id]) {
+                biomes[i] = compiled.fallbackBase;
+            }
+        }
+    }
+
+    public static BiomeBase filterBiome(net.minecraft.server.World world, BiomeBase biome) {
+        Compiled compiled = compiled(world.worldData.getName());
+        if (biome != null && compiled.anyBiomeDisabled && compiled.disabledBiomeIds[biome.id]) {
+            return compiled.fallbackBase;
+        }
+        return biome;
+    }
+
+    public static boolean allowsBlock(net.minecraft.server.World world, Block block) {
+        if (block == Blocks.AIR) {
+            return true;
+        }
+        Compiled compiled = compiled(world.worldData.getName());
+        if (!compiled.anyBlockDisabled) {
+            return true;
+        }
+        int id = Block.getId(block);
+        return id < 0 || id >= MAX_BLOCK_IDS || !compiled.disabledBlockIds[id];
+    }
+
+    public static boolean allowsStructure(net.minecraft.server.World world, WorldGenStructure structure) {
+        return !compiled(world.worldData.getName()).disabledStructures[structure.ordinal()];
+    }
+
+    @Override
+    public boolean isBiomeEnabled(World world, Biome biome) {
+        BiomeBase base = CraftBlock.biomeToBiomeBase(biome);
+        return base == null || !compiled(world.getName()).disabledBiomeIds[base.id];
+    }
+
+    @Override
+    public void setBiomeEnabled(World world, Biome biome, boolean enabled) {
+        updateList(world, settings -> settings.disabledBiomes, biome.name(), enabled);
+    }
+
+    @Override
+    public boolean isBlockEnabled(World world, Material material) {
+        int id = Block.getId(CraftMagicNumbers.getBlock(material));
+        return id < 0 || id >= MAX_BLOCK_IDS || !compiled(world.getName()).disabledBlockIds[id];
+    }
+
+    @Override
+    public void setBlockEnabled(World world, Material material, boolean enabled) {
+        updateList(world, settings -> settings.disabledBlocks, material.name(), enabled);
+    }
+
+    @Override
+    public boolean isStructureEnabled(World world, WorldGenStructure structure) {
+        return !compiled(world.getName()).disabledStructures[structure.ordinal()];
+    }
+
+    @Override
+    public void setStructureEnabled(World world, WorldGenStructure structure, boolean enabled) {
+        updateList(world, settings -> settings.disabledStructures, structure.name(), enabled);
+    }
+
+    @Override
+    public Biome getFallbackBiome(World world) {
+        return compiled(world.getName()).fallbackBiome;
+    }
+
+    @Override
+    public void setFallbackBiome(World world, Biome biome) {
+        OmegaSpigotWorldConfig config = OmegaSpigotConfig.getOrCreateWorldConfig(world.getName());
+        config.worldGeneration.fallbackBiome = biome.name();
+        CACHE.remove(world.getName());
+    }
+
+    @Override
+    public void save() {
+        OmegaSpigotConfig.saveWorldConfigs();
+    }
+
+    private interface ListSelector {
+        List<String> select(OmegaSpigotWorldConfig.WorldGenerationConfig settings);
+    }
+
+    private static void updateList(World world, ListSelector selector, String name, boolean enabled) {
+        OmegaSpigotWorldConfig config = OmegaSpigotConfig.getOrCreateWorldConfig(world.getName());
+        List<String> list = selector.select(config.worldGeneration);
+        list.removeIf(entry -> entry.equalsIgnoreCase(name));
+        if (!enabled) {
+            list.add(name);
+        }
+        CACHE.remove(world.getName());
+    }
+}
