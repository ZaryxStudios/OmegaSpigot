diff --git a/src/main/java/dev/zaryxstudios/escanergang/omegaspigot/worldgen/OmegaWorldGenController.java b/src/main/java/dev/zaryxstudios/escanergang/omegaspigot/worldgen/OmegaWorldGenController.java
