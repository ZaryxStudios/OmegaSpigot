+    // OmegaSpigot start - Runtime world config creation and saving
+    public static OmegaSpigotWorldConfig getOrCreateWorldConfig(String worldName) {
+        OmegaSpigotWorldConfig worldConfig = worldConfigs.get(worldName);
+        if (worldConfig == null) {
+            try {
+                CommentedConfigurationNode node = rootNode.node("worlds", worldName);
+                node.set(defaultWorldConfig);
+                worldConfig = node.get(OmegaSpigotWorldConfig.class);
+            } catch (SerializationException e) {
+                throw Throwables.propagate(e);
+            }
+            worldConfigs.put(worldName, worldConfig);
+        }
+        return worldConfig;
+    }
+
+    public static void saveWorldConfigs() {
+        try {
+            for (Map.Entry<String, OmegaSpigotWorldConfig> entry : worldConfigs.entrySet()) {
+                rootNode.node("worlds", entry.getKey()).set(entry.getValue());
+            }
+            configLoader.save(rootNode);
+        } catch (Exception e) {
+            throw Throwables.propagate(e);
+        }
+    }
+    // OmegaSpigot end
+
     public static OmegaSpigotWorldConfig getWorldConfig(World world) {
         return getWorldConfig(world.worldData.getName());
     }
