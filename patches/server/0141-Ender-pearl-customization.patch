                         }
+                        // OmegaSpigot end
 
                         if (entityliving.au()) {
                             entityliving.mount((Entity) null);
@@ -71,9 +77,14 @@ public class EntityEnderPearl extends EntityProjectile {
 
                         entityplayer.playerConnection.teleport(teleEvent.getTo());
                         entityliving.fallDistance = 0.0F;
-                        CraftEventFactory.entityDamage = this;
-                        entityliving.damageEntity(DamageSource.FALL, 5.0F);
-                        CraftEventFactory.entityDamage = null;
+                        // OmegaSpigot start - Configurable teleport damage
+                        float teleportDamage = OmegaSpigotConfig.enderPearls().teleportDamage;
+                        if (teleportDamage > 0.0F) {
+                            CraftEventFactory.entityDamage = this;
+                            entityliving.damageEntity(DamageSource.FALL, teleportDamage);
+                            CraftEventFactory.entityDamage = null;
