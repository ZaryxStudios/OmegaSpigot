From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: EscanerGang <escaner@zaryxstudios.dev>
Date: Fri, 20 Nov 2026 12:00:00 +0000
Subject: [PATCH] Ender pearl customization

Adds configurable ender pearl stack size, cooldown, throw velocity, teleport damage and endermite chance (enderPearls section), plus a per-world toggle for throwing pearls.

diff --git a/src/main/java/dev/zaryxstudios/escanergang/omegaspigot/config/OmegaSpigotConfig.java b/src/main/java/dev/zaryxstudios/escanergang/omegaspigot/config/OmegaSpigotConfig.java
index 63e0795ba07a4fc90c51e25f0e48a8c0d34da12e..538d4d637d54b22560b76c61c4c8d45d977fa4ef 100644
--- a/src/main/java/dev/zaryxstudios/escanergang/omegaspigot/config/OmegaSpigotConfig.java
+++ b/src/main/java/dev/zaryxstudios/escanergang/omegaspigot/config/OmegaSpigotConfig.java
@@ -136,6 +136,12 @@ public class OmegaSpigotConfig {
     public static OmegaSpigotConfig get() {
         return config;
     }
+
+    // OmegaSpigot start - Safe access to ender pearl settings
+    public static OmegaSpigotConfig.EnderPearlConfig enderPearls() {
+        return config == null ? new EnderPearlConfig() : config.enderPearls;
+    }
+    // OmegaSpigot end
     
     //------------------------------------------------------------------------
     @Comment("On servers with plugins that constantly churn through scoreboards, there is a risk of\n" +
@@ -162,6 +168,29 @@ public class OmegaSpigotConfig {
         "(note that \"max-packet-rate\" is renamed to \"maxPacketRate\")")
     public PacketLimiterConfig packetLimiter = PacketLimiterConfig.createDefault();
 
+    // OmegaSpigot start - Ender pearl customization settings
+    @Comment("Options for ender pearls. Defaults match vanilla behaviour.")
+    public EnderPearlConfig enderPearls = new EnderPearlConfig();
+
+    @ConfigSerializable
+    public static class EnderPearlConfig {
+        @Comment("Maximum stack size of ender pearls (vanilla: 16).")
+        public int maxStackSize = 16;
+
+        @Comment("Ticks a player must wait between two throws (vanilla: 0, 20 ticks = 1 second).")
+        public int cooldownTicks = 0;
+
+        @Comment("Throw speed of ender pearls (vanilla: 1.5).")
+        public float throwVelocity = 1.5F;
+
+        @Comment("Fall damage a player takes after being teleported by a pearl (vanilla: 5.0). 0 disables it.")
+        public float teleportDamage = 5.0F;
+
+        @Comment("Chance (0.0 to 1.0) that a pearl teleport spawns an endermite (vanilla: 0.05).")
+        public float endermiteChance = 0.05F;
+    }
+    // OmegaSpigot end
+
     @Comment("Whether player IP addresses should be logged by the server. This does not impact\n" +
         "the ability of plugins to log the IP addresses of players.")
     public boolean logPlayerIpAddresses = true;
diff --git a/src/main/java/dev/zaryxstudios/escanergang/omegaspigot/config/OmegaSpigotWorldConfig.java b/src/main/java/dev/zaryxstudios/escanergang/omegaspigot/config/OmegaSpigotWorldConfig.java
index 5d3e0981a6e20ad94dde76b17b7341cfe02ba5fc..352a03ceea1b8a7d3013cd6ac5fe8c65e8f63344 100644
