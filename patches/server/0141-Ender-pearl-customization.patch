diff --git a/src/main/java/net/minecraft/server/ItemEnderPearl.java b/src/main/java/net/minecraft/server/ItemEnderPearl.java
index a6b8698ddfa17333b41dbf7055cf8395da3581d5..7deb80853fe8f9d3d90ec5b9f1bba80f9ff4ef68 100644
--- a/src/main/java/net/minecraft/server/ItemEnderPearl.java
+++ b/src/main/java/net/minecraft/server/ItemEnderPearl.java
@@ -1,5 +1,12 @@
 package net.minecraft.server;
 
+// OmegaSpigot start - Ender pearl customization imports
+import dev.zaryxstudios.escanergang.omegaspigot.config.OmegaSpigotConfig;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.UUID;
+// OmegaSpigot end
+
 public class ItemEnderPearl extends Item {
 
     public ItemEnderPearl() {
@@ -7,11 +14,39 @@ public class ItemEnderPearl extends Item {
         this.a(CreativeModeTab.f);
     }
 
+    // OmegaSpigot start - Configurable ender pearl stack size and cooldown
+    private static final Map<UUID, Integer> LAST_THROW_TICK = new HashMap<>();
+
+    @Override
+    public int getMaxStackSize() {
+        return OmegaSpigotConfig.enderPearls().maxStackSize;
+    }
+
+    private static boolean isOnCooldown(EntityHuman entityhuman) {
+        int cooldown = OmegaSpigotConfig.enderPearls().cooldownTicks;
+        if (cooldown <= 0) {
+            return false;
+        }
+        int now = MinecraftServer.currentTick;
+        Integer last = LAST_THROW_TICK.get(entityhuman.getUniqueID());
+        if (last != null && now - last < cooldown) {
+            return true;
+        }
+        LAST_THROW_TICK.put(entityhuman.getUniqueID(), now);
+        return false;
+    }
+    // OmegaSpigot end
+
     @Override
     public ItemStack a(ItemStack itemstack, World world, EntityHuman entityhuman) {
         if (entityhuman.abilities.canInstantlyBuild) {
             return itemstack;
         } else {
+            // OmegaSpigot start - Per-world toggle and cooldown check
+            if (!OmegaSpigotConfig.getWorldConfig(world).enderPearlsEnabled || (!world.isClientSide && isOnCooldown(entityhuman))) {
+                return itemstack;
+            }
+            // OmegaSpigot end
             --itemstack.count;
             world.makeSound(entityhuman, "random.bow", 0.5F, 0.4F / (ItemEnderPearl.g.nextFloat() * 0.4F + 0.8F));
             if (!world.isClientSide) {
