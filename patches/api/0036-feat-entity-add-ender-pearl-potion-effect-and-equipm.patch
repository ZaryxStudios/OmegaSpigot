From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: EscanerGang <escaner@zaryxstudios.dev>
Date: Sat, 21 Nov 2026 15:10:14 +0100
Subject: [PATCH] feat(entity): add ender pearl, potion effect, and equipment
 events

- Introduce EnderpearlLandEvent to allow cancelling ender pearl teleports and inspecting landing reason
- Add PotionEffectEvent base class with Add, Remove, and Expire subclasses for potion effect lifecycle management
- Add EquipmentSetEvent to notify listeners when a player's armor or equipment slot is replaced
- Implement Cancellable interface on events that should permit plugins to prevent default behavior
- Use standard Bukkit HandlerList pattern for consistent event registration and unregistration

diff --git a/src/main/java/org/bukkit/event/entity/EnderpearlLandEvent.java b/src/main/java/org/bukkit/event/entity/EnderpearlLandEvent.java
new file mode 100644
index 0000000000000000000000000000000000000000..6e9a585c62ffae5ad5666354fdcabfb4f47d68a4
--- /dev/null
+++ b/src/main/java/org/bukkit/event/entity/EnderpearlLandEvent.java
@@ -0,0 +1,58 @@
+package org.bukkit.event.entity;
+
+import org.bukkit.entity.EnderPearl;
+import org.bukkit.event.Cancellable;
+import org.bukkit.event.HandlerList;
+
+/**
+ * Called when an ender pearl lands on a block or hits an entity.
+ * Cancelling this event prevents the teleport and removes the pearl.
+ */
+public class EnderpearlLandEvent extends EntityEvent implements Cancellable {
+    private static final HandlerList handlers = new HandlerList();
+    private final Reason reason;
+    private boolean cancelled;
+
+    public EnderpearlLandEvent(final EnderPearl pearl, final Reason reason) {
+        super(pearl);
+        this.reason = reason;
+    }
+
+    @Override
+    public EnderPearl getEntity() {
+        return (EnderPearl) entity;
+    }
+
+    /**
+     * Gets what the ender pearl landed on
+     *
+     * @return the reason for this event
+     */
+    public Reason getReason() {
+        return reason;
+    }
+
+    @Override
+    public boolean isCancelled() {
+        return cancelled;
+    }
+
+    @Override
+    public void setCancelled(boolean cancel) {
+        this.cancelled = cancel;
+    }
+
+    @Override
+    public HandlerList getHandlers() {
+        return handlers;
+    }
+
+    public static HandlerList getHandlerList() {
+        return handlers;
+    }
+
+    public enum Reason {
+        BLOCK,
+        ENTITY
+    }
+}
diff --git a/src/main/java/org/bukkit/event/entity/PotionEffectAddEvent.java b/src/main/java/org/bukkit/event/entity/PotionEffectAddEvent.java
