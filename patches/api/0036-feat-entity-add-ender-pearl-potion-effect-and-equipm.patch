diff --git a/src/main/java/org/bukkit/event/inventory/EquipmentSetEvent.java b/src/main/java/org/bukkit/event/inventory/EquipmentSetEvent.java
new file mode 100644
index 0000000000000000000000000000000000000000..a190be76fcaa4bc34a29fd91faebf8b0ca250829
--- /dev/null
+++ b/src/main/java/org/bukkit/event/inventory/EquipmentSetEvent.java
@@ -0,0 +1,43 @@
+package org.bukkit.event.inventory;
+
+import org.bukkit.entity.HumanEntity;
+import org.bukkit.event.Event;
+import org.bukkit.event.HandlerList;
+import org.bukkit.inventory.ItemStack;
+
+/**
+ * Called after an armor piece of a player's equipment has been replaced.
+ */
+public class EquipmentSetEvent extends Event {
+    private static final HandlerList handlers = new HandlerList();
+    private final HumanEntity humanEntity;
+    private final ItemStack oldItem;
+    private final ItemStack newItem;
+
+    public EquipmentSetEvent(final HumanEntity humanEntity, final ItemStack oldItem, final ItemStack newItem) {
+        this.humanEntity = humanEntity;
+        this.oldItem = oldItem;
+        this.newItem = newItem;
+    }
+
+    public HumanEntity getHumanEntity() {
+        return humanEntity;
+    }
+
+    public ItemStack getOldItem() {
+        return oldItem;
+    }
+
+    public ItemStack getNewItem() {
+        return newItem;
+    }
+
+    @Override
+    public HandlerList getHandlers() {
+        return handlers;
+    }
+
+    public static HandlerList getHandlerList() {
+        return handlers;
+    }
+}
