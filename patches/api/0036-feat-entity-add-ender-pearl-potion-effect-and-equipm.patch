+    public PotionEffectAddEvent(final LivingEntity entity, final PotionEffect effect) {
+        super(entity, effect);
+    }
+
+    @Override
+    public boolean isCancelled() {
+        return cancelled;
+    }
+
+    @Override
+    public void setCancelled(boolean cancel) {
+        this.cancelled = cancel;
+    }
+
+    @Override
